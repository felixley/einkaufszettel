# Cron-Beispiele fuer den Betrieb (Pfad an den Checkout anpassen).
# Alle Skripte sind still bei Erfolg (Exit 0) und laut bei Problemen.
# Ein Exit != 0 sollte vom Cron-Wrapper alarmiert werden (Mail / Uptime Kuma
# Push / systemd OnFailure) — siehe docs/OPERATIONS.md.

# 1) Taegliches Backup (03:17 UTC). Retention + Integritaetspruefung macht
#    backup.sh selbst (RETENTION_DAYS, Default 14).
17 3 * * * cd /opt/einkaufszettel && ./scripts/backup.sh >> ./backups/backup.log 2>&1

# 2) Woechentlicher Restore-Test (Sonntag 04:30 UTC). --mode auto nimmt ein
#    vorhandenes PostgreSQL, sonst Stub/Dry-Run. Exit != 0 alarmieren.
30 4 * * 0 cd /opt/einkaufszettel && ./scripts/test-restore.sh --mode auto >> ./backups/restore-test.log 2>&1

# 3) Taeglicher Zertifikats-Ablaufcheck (07:00 UTC, Schwelle 14 Tage).
#    Exit 1 = Zertifikat laeuft bald ab, Exit 2/3 = Fehler/abgelaufen.
0 7 * * * cd /opt/einkaufszettel && DOMAIN=einkaufszettel.example.ipv64.net ./scripts/check-cert-expiry.sh "${DOMAIN}:443" >> ./backups/cert-check.log 2>&1
