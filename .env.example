# Vorlage – echte Werte NUR in .env (nie ins Repo, nie in Logs, nie in Commit-Nachrichten)
# 1) cp .env.example .env
# 2) Werte unten ersetzen; JWT_SECRET/ANON_KEY/SERVICE_ROLE_KEY per
#    `node scripts/generate-supabase-keys.mjs | tee -a .env` erzeugen.

# --- App / HTTPS (Caddy, T1.3) ---
# DNS-Name bei ipv64.net (A-/AAAA-Record auf Server-IP, auch private IP ok).
DOMAIN=einkaufszettel.example.ipv64.net
ACME_EMAIL=admin@example.com
# Host-Port fuer HTTPS; 443 ist der Normalfall.
HTTPS_PORT=443

# --- Postgres / Supabase self-hosted (T1.3/T1.4) ---
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=postgres
# Mindestens 32 Zeichen. Wird von GoTrue und PostgREST geteilt.
JWT_SECRET=change-me-at-least-32-characters-long
ANON_KEY=change-me-anon-key
SERVICE_ROLE_KEY=change-me-service-role-key

# --- ipv64.net DNS-01 (T1.3) ---
# API-Key nur in .env; Caddy nutzt ihn fuer die DNS-01-Challenge.
IPV64_API_KEY=

# --- Frontend-Auth (apps/web, T2.1) ---
# Browser-Client spricht GoTrue unter /auth/v1 an. Oeffentliche URL eintragen
# (hinter Caddy: https://<DOMAIN>; lokal z. B. http://localhost:8000).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Dev-/E2E-Schalter: "true" erzwingt den Offline-Mock-Adapter (kein GoTrue).
# Ohne gesetzte SUPABASE-URL ist der Mock automatisch aktiv. In Produktion
# NICHT auf "true" setzen; der Mock ist keine echte Authentifizierung.
NEXT_PUBLIC_AUTH_MOCK=

# --- Monitoring (optional, T5.4) ---
# Host-Port der optionalen Uptime-Kuma-Instanz (Compose-Profil "monitoring",
# Start: docker compose --profile monitoring up -d). Siehe docs/OPERATIONS.md.
UPTIME_KUMA_PORT=3001

# --- Optional / spaetere Phasen ---
OPENROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
